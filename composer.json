{
    "name": "gryfoss/twig-smart-mailer",
    "description": "Smart mailer based on Symfony Mailer which supports dynamic source mailboxes and easy integration of files within emails",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "GryfOSS\\Mailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "GryfOSS\\Tests\\Mailer\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "symfony/google-mailer": "^6.0 || ^7.0",
        "symfony/mailer": "^6.0 || ^7.0",
        "symfony/mime": "^6.0 || ^7.0",
        "symfony/twig-bridge": "^6.0 || ^7.0",
        "twig/extra-bundle": "^3.4",
        "twig/twig": "^3"
    },
    "scripts": {
        "fix": "./vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --allow-risky=yes",
        "test:unit": "XDEBUG_MODE=coverage ./vendor/phpunit/phpunit/phpunit",
        "test:unit:coverage": "XDEBUG_MODE=coverage ./vendor/phpunit/phpunit/phpunit --coverage-html coverage-html --coverage-text",
        "test:functional": "./vendor/behat/behat/bin/behat --colors",
        "test:functional:setup": "docker compose -f docker-compose.test.yml up -d mailhog && sleep 5",
        "test:functional:teardown": "docker compose -f docker-compose.test.yml down",
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "ci": [
            "@test:unit:coverage",
            "@test:functional"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8",
        "phpunit/phpunit": "^9.5",
        "php-mock/php-mock-phpunit": "^2.6",
        "behat/behat": "^3.13",
        "guzzlehttp/guzzle": "^7.0"
    }
}
